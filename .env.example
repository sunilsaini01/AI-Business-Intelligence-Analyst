# ==================================================================
# REQUIRED — the app will not start (or is meaningfully insecure)
# without these. No safe defaults exist for any of them.
# ==================================================================

# --- App database (SQLAlchemy-managed, read/write, app schema only) ---
POSTGRES_DB=bi_agent
POSTGRES_USER=bi_app
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Local docker-compose builds this for you (see docker-compose.yml). On
# Render, this must be the managed Postgres URL with the scheme changed to
# postgresql+asyncpg:// — see docs/deployment.md "Database URLs".
DATABASE_URL=postgresql+asyncpg://bi_app:change_me@postgres:5432/bi_agent

# --- Analytical database role (read-only, SELECT on analytics schema only) ---
# Provisioned by app/db/migrations (0001_initial.py creates this role);
# never share credentials with DATABASE_URL above.
READONLY_DB_USER=readonly_analyst
READONLY_DB_PASSWORD=change_me_too
# Same host/port/database as DATABASE_URL, different role, plain
# postgresql:// scheme (asyncpg driver directly, no SQLAlchemy involved).
ANALYTICS_DATABASE_URL=postgresql://readonly_analyst:change_me_too@postgres:5432/bi_agent

# --- LLM (see app/core/llm.py) ---
# LLM_PROVIDER selects which client app.core.llm.get_llm_client() builds.
# Exactly one of ANTHROPIC_API_KEY / GROQ_API_KEY is required, matching
# whichever provider you pick.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- Auth (Phase 14, see app/core/auth.py) ---
# Signs every access token — required, no safe default. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ==================================================================
# OPTIONAL — safe defaults shown below; override only if you need
# different behavior.
# ==================================================================

LLM_MODEL_FAST=claude-haiku-4-5-20251001
LLM_MODEL_STRONG=claude-sonnet-5
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_STRONG=openai/gpt-oss-120b

# Bounded retry w/ exponential backoff for transient errors — passed to
# both SDK clients' own max_retries (they already skip retrying 400/401).
LLM_MAX_RETRIES=2

# --- SQL safety layer (see docs/security.md, blueprint Sec 4) ---
SQL_ROW_LIMIT_DEFAULT=5000
SQL_STATEMENT_TIMEOUT_MS=8000

# --- Critic loop (blueprint Sec 1) ---
CRITIC_MAX_RETRIES=2

# --- Report Generator (Phase 10) ---
# The one optional LLM call in app/agents/report_agent.py — a grounding-
# checked stakeholder-narrative rewrite of the already-validated report.
# Off by default to avoid an extra LLM call (and Groq quota) on every
# single successful analysis; flip to true once quota headroom allows it.
REPORT_NARRATIVE_ENABLED=false

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- SECRET_KEY rotation (Phase 15, see docs/security.md) ---
# SECRET_KEY_ID labels the CURRENT key (embedded in every new token's JWT
# header). Leave PREVIOUS_* unset outside a rotation window; during one,
# set PREVIOUS_SECRET_KEY to the OLD SECRET_KEY value and
# PREVIOUS_SECRET_KEY_ID to the OLD SECRET_KEY_ID, so tokens issued before
# the rotation keep validating until you unset them again.
SECRET_KEY_ID=default
PREVIOUS_SECRET_KEY=
PREVIOUS_SECRET_KEY_ID=

# --- Login rate limiting (Phase 15, see app/core/security.py) ---
# In-memory/per-process — does not coordinate across multiple replicas.
# No Redis added for this; see README's Known Limitations.
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- CORS (final deployment phase, see app/main.py) ---
# The frontend's own origin (comma-separated if you need more than one,
# e.g. a local dev origin plus a deployed Render origin). Not "*" — see
# docs/security.md. Only matters for direct browser->API calls; the
# Streamlit frontend itself talks to this API server-to-server.
FRONTEND_ORIGIN=http://localhost:8511

# --- Frontend -> backend (read by frontend/api_client.py, not this API) ---
# Local docker-compose sets this directly in docker-compose.yml; only
# needed here if running the frontend outside Docker. On Render, set this
# on the FRONTEND service to the deployed backend's URL.
API_BASE_URL=http://localhost:8000

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
