  {
    "id": "bi-004",
    "question": "Why did revenue decrease in July?",
    "expected_intent": "diagnostic",
    "expected_schema": "analytics",
    "expected_tools": ["sql_agent", "analysis_agent", "visualization_agent"],
    "expected_tables": ["analytics.orders", "analytics.order_items", "analytics.customers", "analytics.regions"],
    "expected_analysis_type": "diagnostic",
    "expected_chart_types": ["bar", "horizontal_bar"],
    "reference_query": "SELECT date_trunc('month', o.order_date) AS month, SUM(oi.quantity * oi.unit_price * (1 - oi.discount)) AS revenue FROM analytics.orders o JOIN analytics.order_items oi ON oi.order_id = o.order_id GROUP BY 1 ORDER BY 1;",
    "ground_truth": {
      "type": "period_comparison_with_contribution",
      "baseline_period": "2026-06",
      "current_period": "2026-07",
      "baseline_value": 161445.80,
      "current_value": 150633.02,
      "percentage_change": -6.7,
      "dominant_contributor": {
        "dimension": "segment",
        "group": "Enterprise",
        "prior_value": 16782.83,
        "current_value": 6171.99,
        "change": -10610.84,
        "pct_of_total_change": 74.4
      }
    },
    "tolerance": {"abs": 5.0, "rel": 0.01},
    "expected_key_facts": [
      "july_revenue_below_june",
      "enterprise_segment_declined",
      "north_region_declined"
    ],
    "expected_limitations": false,
    "expected_behavior": "answerable",
    "acceptance_criteria": {
      "min_groundedness": 0.9,
      "min_relevance": 4,
      "must_mention_segments": true
    }
  },
